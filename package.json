{
  "name": "dependabot-updater-action",
  "version": "3.3.0",
  "private": true,
  "description": "Runs Dependabot workloads via GitHub Actions.",
  "main": "src/main.ts",
  "scripts": {
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint --fix **/*.ts",
    "lint-check": "eslint **/*.ts",
    "typecheck": "tsc --noEmit",
    "package": "esbuild src/main.ts src/cleanup.ts --bundle --platform=node --target=node24 --outdir=dist --loader:.node=empty",
    "test": "SKIP_INTEGRATION_TESTS=true jest --detectOpenHandles",
    "test-integration": "jest --detectOpenHandles 'integration'",
    "prepare": "husky install",
    "dependabot": "ts-node src/cli.ts",
    "fetch-images": "esbuild src/fetch-images.ts --bundle --platform=node --target=node24 --loader:.node=empty --outfile=tmp/fetch-images.js && node tmp/fetch-images.js",
    "cleanup-docker": "ts-node src/cleanup.ts",
    "update-container-manifest": "ts-node src/update-containers.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": [
    "actions",
    "dependabot",
    "dependencies"
  ],
  "author": "GitHub",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/http-client": "^4.0.1",
    "@octokit/webhooks-types": "^7.6.1",
    "commander": "^15.0.0",
    "dockerode": "^5.0.1",
    "node-forge": "^1.4.0",
    "tar-stream": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dockerode": "^4.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/node-forge": "^1.3.14",
    "@types/tar-stream": "^3.1.4",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-circus": "^30.2.0",
    "json-server": "^0.17.4",
    "lint-staged": "^17.4.1",
    "prettier": "3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "wait-port": "^1.1.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
